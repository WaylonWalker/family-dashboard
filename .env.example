# Local options. Rename to .env if desired (never commit .env).
LISTEN_ADDR=127.0.0.1:8080
TASKS_FILE=./data/tasks.json
CONTAINER_ENGINE=podman
REGISTRY=ghcr.io
IMAGE_NAME=waylonwalker/family-dashboard
NAMESPACE=family-dashboard
# TAG defaults to sha-<full git SHA> for immutable release identity.

# Optional: read-only Google Calendar feed. Copy the Secret address in iCal
# format from Google Calendar > Settings > [calendar] > Integrate calendar.
# Only a private Google iCal HTTPS URL is supported. Other links produce a
# helpful warning and demo events during `just serve` (production rejects them).
# Never commit the actual URL, or paste it into a chat or issue.
# GOOGLE_CALENDAR_ICAL_URL=https://calendar.google.com/calendar/ical/REPLACE/private-REPLACE/basic.ics

# Optional: use the SAME OpenWeatherMap key as Play Outside.
# In Play Outside Kubernetes, this is the key PLAY_OUTSIDE_OPEN_WEATHER_API_KEY
# in the play-outside-secret Secret. Keep the value local in .env.
# PLAY_OUTSIDE_OPEN_WEATHER_API_KEY=paste-your-existing-key-here
# Default location: Peoria city center, IL. Override to your preferred nearby area.
WEATHER_LATITUDE=40.6936
WEATHER_LONGITUDE=-89.5890
WEATHER_LOCATION_NAME=Peoria area

# Production (NOT needed for `just serve`):
# FAMILY_AUTH_MODE=proxy
# FAMILY_PUBLIC_URL=https://family.wayl.one
# Optional exact HTTPS origins for same-site form submissions through aliases.
# FAMILY_ALLOWED_ORIGINS=https://fam.wayl.one,https://family.waylonwalker.com,https://fam.waylonwalker.com
# FAMILY_TRUSTED_PROXY_CIDRS=10.42.0.0/16
# DEVICES_FILE=./data/devices.json
# Optional separate bearer token for notify-bridge dashboard controls.
# Defaults to FRIGATE_EVENT_TOKEN when unset.
# DASHBOARD_CONTROL_TOKEN=
